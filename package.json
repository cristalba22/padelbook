{
  "name": "book-padel-frontend",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:api": "node --watch server/index.mjs",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "start:api": "node server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "framer-motion": "^12.23.24",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "mongoose": "^9.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^8.0.16",
    "wrangler": "^4.135.0"
  }
}
