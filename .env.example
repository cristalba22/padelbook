# Vite
VITE_APP_NAME=PadelBook
VITE_API_URL=http://localhost:4000/api
# Solo para una demo pública sin backend. Nunca activar para un club real.
VITE_DEMO_MODE=false

# Club
VITE_CLUB_NAME=Arena Norte Padel Club
VITE_CLUB_SHORT_NAME=PadelBook
VITE_CLUB_ADDRESS=Edmundo Mariotte 5308 - Córdoba Capital
VITE_CLUB_MAPS_QUERY=Edmundo Mariotte 5308, Córdoba, Argentina
VITE_CLUB_WHATSAPP=5493510000000
VITE_CLUB_INSTAGRAM=padelbook.club
VITE_CLUB_OPENING_HOURS=09:00 a 22:00
VITE_CLUB_STATUS=Club abierto - reservas online

# Home
VITE_HOME_HEADLINE=Tu próximo partido empieza antes de llegar a la cancha.
VITE_HOME_SUBTITLE=Reservá cancha, coordiná la seña con el club, consultá tus turnos y sumate a torneos desde una experiencia simple y rápida.
VITE_HOME_PROMO_TEXT=Tus turnos, siempre organizados

# Precios iniciales
VITE_DEFAULT_COURT_PRICE=18000
VITE_DEFAULT_NIGHT_PRICE=24000
VITE_DEFAULT_WEEKEND_EXTRA=3000
VITE_DEFAULT_CLASS_PRICE=30000
VITE_DEFAULT_TOURNAMENT_PRICE=25000
VITE_DEFAULT_TEACHER_COMMISSION=50

# API
PORT=4000
JWT_SECRET=generate-at-least-48-random-characters-before-production
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
TOKEN_EXPIRES_IN=8h
COOKIE_SAME_SITE=strict
API_PROXY_SECRET=generate-an-independent-48-character-random-secret
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/padelbook
MONGODB_DB_NAME=padelbook_club_piloto
PADELBOOK_DEMO_SEED=true
# Para una base nueva sin datos de ejemplo: PADELBOOK_DEMO_SEED=false y completá:
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Recuperación de contraseña por correo (Resend)
RESEND_API_KEY=
PASSWORD_RESET_FROM=PadelBook <cuentas@tu-dominio.com>
PASSWORD_RESET_REPLY_TO=

# Integraciones externas
VITE_MP_PUBLIC_KEY=
